#!/usr/bin/env bash
set -euo pipefail

readonly image_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly repository="$(dirname "${image_directory}")"
readonly kernel_version="${AMAFU_KERNEL_VERSION:-7.0.0-42}"
readonly kernel_release="${kernel_version}-generic"
readonly variant="${1:-}"
readonly firmware_release="ch-97eeb7b09"
readonly firmware_sha256="dc2fc8f0e43b96712d9fccc52a3a590769606412b3e1bc911d217addd3bef624"
readonly node_tools=(/usr/sbin/nft /usr/bin/mkfs.erofs)
readonly guest_kernel_version="6.18.60"
readonly guest_kernel_sha256="3c2f44ef6acc021a7ad444d9a2e6ec1ef488ff09368793d0004a6080f69d621e"
readonly guest_kernel_configuration="${image_directory}/container-kernel.config"
readonly kernel_build_tools=(make gcc flex bison bc)

usage() {
    echo "usage: image/build test|release [path to amafu-node]" >&2
    exit 2
}

case "${variant}" in
    test) cargo_features=(--features diagnostics) ;;
    release) cargo_features=() ;;
    *) usage ;;
esac

readonly output="${image_directory}/output/${variant}"
readonly cache="${image_directory}/output/cache"
readonly staging="${image_directory}/output/staging-${variant}"
readonly boot_staging="${image_directory}/output/boot-staging-${variant}"
binary="${2:-}"

build_binaries() {
    if [[ -z "${binary}" ]]; then
        cargo build --manifest-path "${repository}/Cargo.toml" --release -p amafu-node "${cargo_features[@]}"
        binary="${repository}/target/release/amafu-node"
    fi
    cargo build --manifest-path "${repository}/Cargo.toml" --release -p amafu-guest-agent
    guest_agent="${repository}/target/release/amafu-guest-agent"
}

check_node_tools() {
    for tool in "${node_tools[@]}"; do
        if [[ ! -x "${tool}" ]]; then
            echo "${tool} is missing; install nftables and erofs-utils" >&2
            exit 1
        fi
    done
}

download_firmware() {
    local firmware="${cache}/CLOUDHV-${firmware_release}.fd"
    if [[ ! -f "${firmware}" ]]; then
        curl --fail --silent --show-error --location --output "${firmware}.partial" \
            "https://github.com/cloud-hypervisor/edk2/releases/download/${firmware_release}/CLOUDHV.fd"
        mv "${firmware}.partial" "${firmware}"
    fi
    echo "${firmware_sha256}  ${firmware}" | sha256sum --check --quiet
}

download_packages() {
    mkdir -p "${cache}"
    local packages=(
        "linux-image-${kernel_release}"
        "linux-modules-${kernel_release}"
        shim-signed
        grub-efi-amd64-signed
        busybox-static
    )
    (
        cd "${cache}"
        for package in "${packages[@]}"; do
            if ! compgen -G "${package}_*.deb" >/dev/null; then
                apt-get download "${package}"
            fi
        done
    )
}

extract_packages() {
    rm -rf "${cache}/extracted"
    mkdir -p "${cache}/extracted"
    for package in "${cache}"/*.deb; do
        dpkg-deb --extract "${package}" "${cache}/extracted"
    done
    if [[ ! -e "${cache}/extracted/lib" ]]; then
        ln -s usr/lib "${cache}/extracted/lib"
    fi
    depmod --basedir "${cache}/extracted" "${kernel_release}"
}

resolve_modules() {
    local modules_root="${cache}/extracted/usr/lib/modules/${kernel_release}"
    python3 - "${modules_root}" "$1" <<'PYTHON'
import sys
from pathlib import Path

modules_root = Path(sys.argv[1])
wanted = [line.strip() for line in Path(sys.argv[2]).read_text().splitlines() if line.strip()]
dependencies = {}
for line in (modules_root / "modules.dep").read_text().splitlines():
    module, _, needed = line.partition(":")
    dependencies[module] = needed.split()
by_name = {Path(module).name.split(".ko")[0]: module for module in dependencies}
built_in = {Path(line).name.split(".ko")[0] for line in (modules_root / "modules.builtin").read_text().split()}
ordered = []

def visit(module):
    for dependency in dependencies[module]:
        visit(dependency)
    if module not in ordered:
        ordered.append(module)

for name in wanted:
    if name not in built_in:
        visit(by_name[name])
print("\n".join(ordered))
PYTHON
}

stage_modules() {
    local list="$1"
    local root="$2"
    local order="${3:-load-order}"
    local target="${4:-${root}/usr/lib/amafu/modules}"
    local modules_root="${cache}/extracted/usr/lib/modules/${kernel_release}"
    mkdir -p "${target}"
    : > "${target}/${order}"
    while read -r module; do
        local name
        name="$(basename "${module}" .zst)"
        zstd --quiet --decompress --force "${modules_root}/${module}" -o "${target}/${name}"
        echo "${name}" >> "${target}/${order}"
    done < <(resolve_modules "${list}")
}

stage_libraries() {
    local executable="$1"
    local root="$2"
    ldd "${executable}" | awk '/=>/ { print $3 } /^\t\// { print $1 }' | while read -r library; do
        mkdir -p "${root}$(dirname "${library}")"
        cp --dereference "${library}" "${root}${library}"
    done
}

pack_initramfs() {
    local root="$1"
    local output_file="$2"
    (cd "${root}" && find . | LC_ALL=C sort | cpio --quiet --create --format=newc --reproducible) | zstd --quiet -19 -T0 > "${output_file}"
}

build_container_initramfs() {
    local root="${image_directory}/output/container-root"
    rm -rf "${root}"
    mkdir -p "${root}"/{dev,proc,sys,run,tmp,etc,usr/bin}
    install -m 0755 "${guest_agent}" "${root}/usr/bin/amafu-guest-agent"
    ln -s usr/bin/amafu-guest-agent "${root}/init"
    stage_libraries "${guest_agent}" "${root}"
    pack_initramfs "${root}" "${boot_staging}/container-initramfs"
    rm -rf "${root}"
}

stage_node_tools() {
    local tools="${boot_staging}/tools"
    mkdir -p "${tools}/lib"
    for tool in "${node_tools[@]}"; do
        install -m 0755 "${tool}" "${tools}/$(basename "${tool}")"
        ldd "${tool}" | awk '/=>/ { print $3 }' | while read -r library; do
            cp --dereference "${library}" "${tools}/lib/$(basename "${library}")"
        done
    done
    install -m 0644 "${cache}/CLOUDHV-${firmware_release}.fd" "${boot_staging}/CLOUDHV.fd"
}

build_test_guest() {
    local guest="${image_directory}/output/test-guest"
    rm -rf "${guest}"
    mkdir -p "${guest}/bin" "${guest}/proc" "${guest}/sys" "${guest}/dev"
    cp "${cache}/extracted/usr/bin/busybox" "${guest}/bin/busybox"
    cp "${image_directory}/test-guest/init" "${guest}/init"
    cp "${image_directory}/test-guest/lease" "${guest}/bin/lease"
    local target="${staging}/usr/lib/amafu/images/test-guest"
    mkdir -p "${target}"
    pack_initramfs "${guest}" "${target}/initramfs"
    ln -s /run/amafu/boot/amafu/vmlinux "${target}/kernel"
    cp "${image_directory}/test-guest/command-line" "${target}/command-line"
}

stage_root() {
    rm -rf "${staging}" "${boot_staging}"
    mkdir -p "${boot_staging}"
    mkdir -p "${staging}"/{dev,proc,sys,run,tmp,etc,var/lib/amafu,usr/bin}
    install -m 0755 "${binary}" "${staging}/usr/bin/amafu-node"
    ln -s usr/bin/amafu-node "${staging}/init"
    stage_libraries "${binary}" "${staging}"
    stage_modules "${image_directory}/early-modules" "${staging}" early-load-order
    stage_modules "${image_directory}/modules" "${staging}" load-order "${boot_staging}/modules"
    stage_modules "${image_directory}/watchdog-modules" "${staging}" watchdog-load-order "${boot_staging}/modules"
    stage_node_tools
    build_container_initramfs
    if [[ "${variant}" == test ]]; then
        build_test_guest
    fi
}

download_guest_kernel_source() {
    local source="${cache}/linux-${guest_kernel_version}.tar.xz"
    if [[ ! -f "${source}" ]]; then
        curl --fail --silent --show-error --location --output "${source}.partial" \
            "https://cdn.kernel.org/pub/linux/kernel/v${guest_kernel_version%%.*}.x/linux-${guest_kernel_version}.tar.xz"
        mv "${source}.partial" "${source}"
    fi
    echo "${guest_kernel_sha256}  ${source}" | sha256sum --check --quiet
}

check_kernel_options() {
    local configuration="$1"
    local missing=0
    while read -r option; do
        if ! grep -qx "${option}" "${configuration}"; then
            echo "the guest kernel lacks ${option}" >&2
            missing=1
        fi
    done < <(grep '=y$' "${guest_kernel_configuration}")
    return "${missing}"
}

build_guest_kernel() {
    local fingerprint
    fingerprint="$(sha256sum "${guest_kernel_configuration}" | cut -c1-16)"
    guest_kernel="${cache}/guest-vmlinux-${guest_kernel_version}-${fingerprint}"
    if [[ -f "${guest_kernel}" ]]; then
        return
    fi
    for tool in "${kernel_build_tools[@]}"; do
        command -v "${tool}" >/dev/null || { echo "${tool} is missing; install make gcc flex bison bc libelf-dev" >&2; exit 1; }
    done
    download_guest_kernel_source
    local workspace
    workspace="$(mktemp -d)"
    tar --extract --file "${cache}/linux-${guest_kernel_version}.tar.xz" --directory "${workspace}"
    local tree="${workspace}/linux-${guest_kernel_version}"
    make --silent -C "${tree}" allnoconfig KCONFIG_ALLCONFIG="${guest_kernel_configuration}"
    if ! check_kernel_options "${tree}/.config"; then
        rm -rf "${workspace}"
        exit 1
    fi
    make --silent -C "${tree}" -j"$(nproc)" vmlinux >/dev/null
    cp "${tree}/vmlinux" "${guest_kernel}.partial"
    mv "${guest_kernel}.partial" "${guest_kernel}"
    rm -rf "${workspace}"
}

pack() {
    rm -rf "${output}"
    mkdir -p "${output}/esp/EFI/BOOT" "${output}/esp/EFI/ubuntu" "${output}/esp/amafu"
    pack_initramfs "${staging}" "${output}/esp/amafu/initramfs"
    cp "${cache}/extracted/boot/vmlinuz-${kernel_release}" "${output}/esp/amafu/vmlinuz"
    cp "${guest_kernel}" "${output}/esp/amafu/vmlinux"
    cp -r "${boot_staging}"/. "${output}/esp/amafu/"
    cp "${cache}/extracted/usr/lib/shim/shimx64.efi.signed.latest" "${output}/esp/EFI/BOOT/BOOTX64.EFI"
    cp "${cache}/extracted/usr/lib/grub/x86_64-efi-signed/grubx64.efi.signed" "${output}/esp/EFI/BOOT/grubx64.efi"
    cp "${image_directory}/grub.cfg" "${output}/esp/EFI/ubuntu/grub.cfg"
    (cd "${output}/esp" && find . -type f | LC_ALL=C sort | xargs sha256sum) > "${output}/SHA256SUMS"
    du -sb "${output}/esp" | awk '{ printf "image size: %.1f MiB\n", $1 / 1048576 }'
}

check_node_tools
build_binaries
download_packages
download_firmware
build_guest_kernel
extract_packages
stage_root
pack
rm -rf "${staging}" "${boot_staging}"
echo "built the ${variant} image in ${output}"
